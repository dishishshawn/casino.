# =============================================================================
# Casino — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# -----------------------------------------------------------------------------
# Trading system (casino/)
# -----------------------------------------------------------------------------

# Anthropic Claude API (required: signal scoring, transcript analysis)
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Alpaca brokerage (required: paper trading in v1, live cash account in v2)
ALPACA_API_KEY="your_alpaca_key_id_here"
ALPACA_SECRET_KEY="your_alpaca_secret_here"
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# Tiingo market data (required: OHLCV, fundamentals, news)
TIINGO_API_KEY="your_tiingo_key_here"

# Financial Modeling Prep (optional: earnings call transcripts)
FMP_API_KEY="your_fmp_key_here"

# Discord webhook (optional: mobile alerts for fills, drawdown, errors)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/.../..."

# -----------------------------------------------------------------------------
# Taskmaster AI (optional: only if not using the claude-code provider)
# -----------------------------------------------------------------------------
# By default this project routes Taskmaster through the claude-code provider,
# which uses your Claude Code session. The keys below are only needed if you
# switch Taskmaster to a different provider via `task-master models --set-*`.

# PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # research (pplx-...)
# OPENAI_API_KEY="your_openai_api_key_here"             # alt main (sk-proj-...)
# GOOGLE_API_KEY="your_google_api_key_here"             # Gemini
# MISTRAL_API_KEY="your_mistral_key_here"
# XAI_API_KEY="your_xai_key_here"
# GROQ_API_KEY="your_groq_key_here"
# OPENROUTER_API_KEY="your_openrouter_key_here"
# AZURE_OPENAI_API_KEY="your_azure_key_here"            # also needs endpoint in .taskmaster/config.json
# OLLAMA_API_KEY="your_ollama_api_key_here"             # only for authed remote Ollama
# GITHUB_API_KEY="your_github_pat_here"                 # ghp_... or github_pat_...
